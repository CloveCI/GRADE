yarn-error.log*
pnpm-debug.log*

# ── Runtime data (uploaded sheets, page previews) ────────────────────────────
# The API writes these relative to backend/; keep the old root path ignored for existing clones.
/data/
/backend/data/

# ── Generated OCR / RAG output (regenerate with backend/scripts/ocr_pdf.py) ──
extraction.json
extraction-*.json

# ── Private sample scans and keys (share deliberately, not by accident) ──────
Key.pdf
DocScanner*.pdf

