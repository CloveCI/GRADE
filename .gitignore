# ── Env & secrets ────────────────────────────────────────────────────────────
# Real env files never go in git; only the documented *.example templates do.
.env
.env.*
!.env.example
*.local
*-service-account*.json
google-credentials.json
*.pem
*.p12
*.pfx

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.dist/
build/
.coverage
coverage.xml
htmlcov/
.tox/

