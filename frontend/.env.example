# GRADE Companion UI — copy to .env in this folder (optional).
# Leave VITE_API_URL empty when using Vite dev proxy (default).

# Empty = same-origin proxy to FastAPI (see vite.config.ts → http://127.0.0.1:8000)
VITE_API_URL=

# Or point directly at the API (e.g. production):
# VITE_API_URL=http://127.0.0.1:8000
